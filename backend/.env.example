# Leave TG_MODE=anonymous to read the public channel preview without a Telegram
# account. Likes then stay local to this machine.
TG_MODE=anonymous
TG_CHANNEL=radio_dungeon

# Only needed for TG_MODE=account (likes are sent to the channel).
# Get these at https://my.telegram.org/apps
TG_API_ID=
TG_API_HASH=
